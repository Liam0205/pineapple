          { "item_id": "i2", "item_key": { "b": 1.5, "a": 0.1 } },
          { "item_id": "i3", "item_key": [1e-7, 1e21] },
          { "item_id": "i4", "item_key": ["<x>&"] },
          { "item_id": "i5", "item_key": [0.30000000000000004, -0.0] },
          { "item_id": "i6", "item_key": { "z": [1.0, { "y": 2.0 }] } },
          { "item_id": "i7", "item_key": [] }
