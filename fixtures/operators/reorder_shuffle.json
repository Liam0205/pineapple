      "metadata": {
        "common_input": ["salt"],
        "item_input": ["item_id"],
        "common_output": [],
        "item_output": []
      },
      "input": {
        "common": { "salt": "alpha" },
        "items": [
          { "item_id": "1" },
          { "item_id": "2" },
          { "item_id": "3" },
          { "item_id": "4" },
          { "item_id": "5" }
        ]
      },
