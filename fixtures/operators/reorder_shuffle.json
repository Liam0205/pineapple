    {
      "name": "shuffle with numeric item ids",
      "params": {},
      "metadata": {
        "common_input": ["salt"],
        "item_input": ["item_id"],
        "common_output": [],
        "item_output": []
      },
      "input": {
        "common": { "salt": "gamma" },
        "items": [
          { "item_id": "100" },
          { "item_id": "200" },
          { "item_id": "300" },
          { "item_id": "400" }
        ]
      },
      "expected": {
        "item_order": [1, 2, 0, 3]
