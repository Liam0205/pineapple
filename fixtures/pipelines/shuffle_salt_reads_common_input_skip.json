{
  "name": "shuffle_by_salt with skip field in metadata.common_input_skip bucket (issue #174 variant)",
  "_comment": "Companion to shuffle_salt_reads_skip_field.json. The excluded_common set on pine-cpp merges three sources: config.skip, metadata.common_input_skip (#74 disjoint bucket layout), metadata.common_input_template. This variant routes the skip field through common_input_skip instead of the legacy common_input+skip pattern to prove the second source is also honored end to end. common_input_template already routes through templated_param and has separate coverage.",
  "config": {
    "_PINEAPPLE_VERSION": "0.10.15",
    "pipeline_config": {
      "operators": {
        "recall": {
          "type_name": "recall_static",
          "recall": true,
          "items": [
            {"item_id": "a", "item_tag": "x"},
            {"item_id": "b", "item_tag": "y"},
            {"item_id": "c", "item_tag": "z"},
            {"item_id": "d", "item_tag": "x"}
          ],
          "$metadata": {
            "common_input": [],
            "common_output": [],
            "item_input": [],
            "item_output": ["item_id", "item_tag"]
          }
        },
        "set_skip": {
          "type_name": "transform_by_lua",
          "lua_script": "function check()\n  return false\nend",
          "function_for_item": "",
          "function_for_common": "check",
          "$metadata": {
            "common_input": [],
            "common_output": ["_skip_branch"],
            "item_input": [],
            "item_output": []
          }
        },
        "shuffle": {
          "type_name": "reorder_shuffle_by_salt",
          "$metadata": {
            "common_input": ["_skip_branch"],
            "common_input_skip": ["_skip_branch"],
            "common_output": [],
            "item_input": ["item_tag"],
            "item_output": []
          }
        }
      },
      "pipeline_map": {
        "main_stage": {
          "pipeline": ["recall", "set_skip", "shuffle"]
        }
      }
    },
    "pipeline_group": {
      "main": {
        "pipeline": ["main_stage"]
      }
    },
    "flow_contract": {
      "common_input": [],
      "item_input": [],
      "common_output": [],
      "item_output": ["item_id", "item_tag"]
    }
  },
  "cases": [
    {
      "name": "common_input_skip source of the excluded_common set is also honored across all runtimes",
      "request": {
        "common": {},
        "items": []
      },
      "expected": {
        "common": {},
        "items": [
          {"item_id": "c", "item_tag": "z"},
          {"item_id": "b", "item_tag": "y"},
          {"item_id": "a", "item_tag": "x"},
          {"item_id": "d", "item_tag": "x"}
        ]
      }
    }
  ]
}
